# Groq (free at console.groq.com)
GROQ_API_KEY=gsk_...

# GitHub (optional — 60 req/hour unauthenticated, 5000/hour with token)
# Generate at: https://github.com/settings/tokens (no scopes needed for public search)
GITHUB_TOKEN=ghp_...

# LinkedIn OAuth App (from https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback

# LinkedIn credentials (written by `npm run setup`)
LINKEDIN_ACCESS_TOKEN=AQV...
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX
